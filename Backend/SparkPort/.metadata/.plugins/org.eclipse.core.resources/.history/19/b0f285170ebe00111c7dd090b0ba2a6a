package com.parkspot.service;

package com.parkspot.service;

import com.parkspot.dto.TicketDTO;
import com.parkspot.entity.Espacio;
import com.parkspot.entity.Reserva;
import com.parkspot.entity.Ticket;
import com.parkspot.entity.Usuario;
import com.parkspot.repository.EspacioRepository;
import com.parkspot.repository.ReservaRepository;
import com.parkspot.repository.TicketRepository;
import com.parkspot.repository.UsuarioRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
/**
 * Servicio para la entidad Ticket.
 * Los tickets se generan automáticamente al confirmar una reserva.
 */
@Service
@Transactional
public class TicketService {

    @Autowired
    private TicketRepository repo;

    @Autowired
    private UsuarioRepository usuarioRepo;

    @Autowired
    private ReservaRepository reservaRepo;

    @Autowired
    private EspacioRepository espacioRepo;

    private static final DateTimeFormatter DATE_FORMATTER = DateTimeFormatter.ofPattern("yyyy-MM-dd");

    // ==========================================
    // MÉTODOS CRUD PRINCIPALES
    // ==========================================

    public TicketDTO buscarPorId(Long id) {
        Ticket entity = repo.findById(id).orElse(null);
        return entity != null ? convertirADTO(entity) : null;
    }

    /**
     * Busca un ticket por su código (ej. PS-2026-07-28-00123).
     * Usado por el operador para validar el ticket.
     */
    public TicketDTO buscarPorCodigo(String codigo) {
        Ticket entity = repo.findByCodigo(codigo).orElse(null);
        return entity != null ? convertirADTO(entity) : null;
    }

    public TicketDTO buscarPorReserva(Long reservaId) {
        Ticket entity = repo.findByReservaId(reservaId).orElse(null);
        return entity != null ? convertirADTO(entity) : null;
    }

    // ==========================================
    // MÉTODOS DE NEGOCIO
    // ==========================================

    /**
     * Genera un ticket para una reserva confirmada.
     */
    public Ticket generarTicket(Reserva reserva, BigDecimal montoPagado) {
        // Validar que no exista ticket para esta reserva
        if (repo.existsByReservaId(reserva.getId())) {
            throw new RuntimeException("Ya existe un ticket para esta reserva.");
        }

        Ticket ticket = new Ticket();
        ticket.setReserva(reserva);

        // Generar código: PS-YYYY-MM-DD-XXXXX
        String codigo = generarCodigoTicket();
        ticket.setCodigo(codigo);

        // Generar QR (simplificado, en producción usaría una librería como ZXing)
        ticket.setQrCode("QR_" + codigo);

        ticket.setMontoPagado(montoPagado);
        ticket.setCobroAdicional(BigDecimal.ZERO);

        return repo.save(ticket);
    }

    /**
     * Registra el ingreso físico del vehículo (lo hace el operador).
     */
    public TicketDTO registrarIngreso(Long ticketId, Long operadorId) {
        Ticket ticket = repo.findById(ticketId)
                .orElseThrow(() -> new RuntimeException("Ticket no encontrado con ID: " + ticketId));

        if (ticket.getFechaIngresoReal() != null) {
            throw new RuntimeException("El vehículo ya ingresó.");
        }

        Usuario operador = usuarioRepo.findById(operadorId)
                .orElseThrow(() -> new RuntimeException("Operador no encontrado con ID: " + operadorId));

        ticket.setFechaIngresoReal(LocalDateTime.now());
        ticket.setOperadorIngreso(operador);

        // Cambiar estado de la reserva a ACTIVA (a través de ReservaService)
        // Esto lo hará el ReservaService llamando a este método

        repo.save(ticket);
        return convertirADTO(ticket);
    }

    /**
     * Registra la salida física del vehículo (lo hace el operador).
     */
    public TicketDTO registrarSalida(Reserva reserva, LocalDateTime fechaSalidaReal) {
        Ticket ticket = repo.findByReservaId(reserva.getId())
                .orElseThrow(() -> new RuntimeException("Ticket no encontrado para la reserva."));

        if (ticket.getFechaSalidaReal() != null) {
            throw new RuntimeException("El vehículo ya salió.");
        }

        ticket.setFechaSalidaReal(fechaSalidaReal);

        // Calcular cobro adicional (lo hace ReservaService y pasa el monto)
        // El cobro adicional se actualiza desde ReservaService

        repo.save(ticket);
        return convertirADTO(ticket);
    }

    /**
     * Actualiza el cobro adicional en el ticket.
     */
    public void actualizarCobroAdicional(Long ticketId, BigDecimal cobroAdicional) {
        Ticket ticket = repo.findById(ticketId)
                .orElseThrow(() -> new RuntimeException("Ticket no encontrado con ID: " + ticketId));

        ticket.setCobroAdicional(cobroAdicional);
        repo.save(ticket);
    }

    // ==========================================
    // MÉTODOS PRIVADOS
    // ==========================================

    /**
     * Genera un código único para el ticket.
     * Formato: PS-YYYY-MM-DD-XXXXX (secuencia numérica)
     */
    private String generarCodigoTicket() {
        String fecha = LocalDateTime.now().format(DATE_FORMATTER);

        // Obtener el último código para generar la secuencia
        // En producción, usaría una secuencia en la BD o Redis
        // Para simplificar, usamos timestamp
        String secuencia = String.format("%05d", System.currentTimeMillis() % 100000);

        return "PS-" + fecha + "-" + secuencia;
    }

    // ==========================================
    // MÉTODOS AUXILIARES (Conversión)
    // ==========================================

    private TicketDTO convertirADTO(Ticket entity) {
        TicketDTO dto = new TicketDTO();
        dto.setId(entity.getId());
        dto.setReservaId(entity.getReserva().getId());
        dto.setCodigo(entity.getCodigo());
        dto.setQrCode(entity.getQrCode());
        dto.setMontoPagado(entity.getMontoPagado());

        dto.setFechaIngresoReal(entity.getFechaIngresoReal());
        dto.setFechaSalidaReal(entity.getFechaSalidaReal());

        dto.setOperadorIngresoId(entity.getOperadorIngreso() != null ? entity.getOperadorIngreso().getId() : null);
        dto.setOperadorSalidaId(entity.getOperadorSalida() != null ? entity.getOperadorSalida().getId() : null);

        dto.setCobroAdicional(entity.getCobroAdicional());

        // Datos anidados
        dto.setNombreUsuario(entity.getReserva().getUsuario().getNombres() + " " +
                entity.getReserva().getUsuario().getApellidos());
        dto.setCodigoEspacio(entity.getReserva().getEspacio().getCodigo());
        dto.setPlacaVehiculo(entity.getReserva().getVehiculo().getPlaca());

        return dto;
    }
}